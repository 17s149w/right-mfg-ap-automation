# Copy to .env and fill in for the REAL instance. (dotenv not required — export
# these in your shell, or `set -a; source .env; set +a`.)

# --- target selection ---
AP_TARGET=real            # 'mock' (local) or 'real'

# --- real JobBOSS2 connection ---
JB_URL=https://your-jobboss2-host
JB_LOGIN_PATH=/
JB_AP_PATH=/your-ap-entry-route
JB_USER=your-username
JB_PASS=your-password     # ONLY if plain form login. For SSO/MFA use storageState (see FEASIBILITY.md §3).

# --- working directory (state lives OUTSIDE the synced skill folder) ---
# Set by ap-setup, usually via src/runtime-path.json rather than this var.
# AP_WORK_DIR=/Users/you/Library/CloudStorage/OneDrive-.../Right Mfg AP/_AP Automation

# --- behavior knobs (settings.json is the real source; these override for testing) ---
AP_DRY_RUN=true           # true = never click Save AND never write the ledger. Set false only after clean attended runs.
AP_TOLERANCE_CENTS=0      # integer cents; 0 = exact match (v1). e.g. 5 to absorb a nickel.
AP_LOOKUP_MODE=blur       # 'blur' (Tab out of PO to trigger AJAX) or 'button' (click a Lookup/Search button)
AP_HEADLESS=false         # false = watch the browser; true = headless
AP_SLOWMO=0               # ms delay between actions when watching

# --- timeouts (ms) — JobBOSS2 can be slow ---
AP_NAV_TIMEOUT=45000
AP_EL_TIMEOUT=20000
AP_LOOKUP_SETTLE=1500
